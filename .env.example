# Copier ce fichier en `.env` (à la racine du projet) et remplir la clé.
# Clé de développement : https://developer.riotgames.com (expire toutes les 24 h)
RIOT_API_KEY=

# Compte suivi (gameName#tagLine). Guillemets obligatoires : sinon dotenv lit le « # » comme un commentaire.
RIOT_ID="Maksenoff#EUW"

# Routage Riot : région (Account-V1, Match-V5) et plateforme (League, Mastery, Spectator)
RIOT_REGION=europe
RIOT_PLATFORM=euw1

# Port local du backend (écoute uniquement en local : localhost)
PORT=3417

# Dossier des données (SQLite, cache Data Dragon).
# Vide = %LOCALAPPDATA%\xeneon-lol (recommandé : hors OneDrive)
DATA_DIR=

# Niveau de log : fatal | error | warn | info | debug | trace
LOG_LEVEL=info
