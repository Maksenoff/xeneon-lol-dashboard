{
  "name": "xeneon-lol-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend local LoL pour widgets iCUE (Xeneon Edge) — usage personnel",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "undici": "^8.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
